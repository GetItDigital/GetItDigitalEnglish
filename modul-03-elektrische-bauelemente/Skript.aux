\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces \textbf {Real voltage source with internal resistance.} The voltage $U_\mathrm  {q}$ is influenced by the internal resistance \(R_\mathrm  {i}\) and is therefore lower at the output terminals.}}{13}{figure.caption.20}\protected@file@percent }
\newlabel{fig:re spannungsquelle}{{3.2}{13}{\textbf {Real voltage source with internal resistance.} The voltage $U_\mathrm {q}$ is influenced by the internal resistance \(R_\mathrm {i}\) and is therefore lower at the output terminals}{figure.caption.20}{}}
